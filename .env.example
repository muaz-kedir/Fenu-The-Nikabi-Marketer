# ==============================================================================
# Fenu The Nikabi Marketer - Environment Configuration
# ==============================================================================

# --- Frontend Variables (Vite - exposed to client bundle) ---
# For unified AletCloud / single-service deployment, leave VITE_API_BASE_URL blank.
# Only set VITE_API_BASE_URL if the backend is hosted as a separate service (e.g. on Render).
VITE_API_BASE_URL=

# Optional Supabase credentials (only if using Supabase directly from frontend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Backend Variables (Node/Express - Private, never exposed to browser) ---
# Port provided dynamically by AletCloud / host (defaults to 3000 / 3001)
PORT=3000

# PostgreSQL Connection String (e.g. Supabase, Neon, Render Postgres, or local)
DATABASE_URL=postgresql://ayine_user:ayine_password@localhost:5432/fenu_portfolio

# CMS Admin Credentials (used for initial DB seed and secure admin authentication)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
LOCAL_ADMIN_EMAIL=admin@example.com
LOCAL_ADMIN_PASSWORD=admin123

# Admin JWT / Token Secret for HMAC signing
ADMIN_JWT_SECRET=fenu-portfolio-secure-admin-token-secret-2026

